{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/browserconfig.xml",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "zitflow-pwa-assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/pwa/icons/**",
          "/assets/pwa/favicon/**",
          "/assets/logos/**",
          "/apple-touch-icon.png",
          "/favicon-16.png",
          "/favicon-32.png",
          "/favicon-96x96.png",
          "/web-app-manifest-192x192.png",
          "/web-app-manifest-512x512.png"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [],
  "navigationUrls": [
    "/**",
    "!/**/oauth2/token**",
    "!/**/api/security/user/auth/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**"
  ]
}
