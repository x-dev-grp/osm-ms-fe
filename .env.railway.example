# Railway testing — frontend service variables

PORT=8080

# Prefer private networking (same Railway project) — nginx proxies /oauth2, /api, /ws:
BACKEND_URL=http://charismatic-hope.railway.internal:8084
# Or public URL if services are in different projects:
# BACKEND_URL=https://your-backend.up.railway.app

# Nginx proxies /api, /oauth2, /ws, /.well-known, /jwks, /actuator to BACKEND_URL.
# Railway often blocks outbound SMTP — disable mail and return initial password in API response.
MAIL_ENABLED=false
# Angular uses relative paths in production (apiUrl='').
