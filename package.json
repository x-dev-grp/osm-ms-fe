{
  "name": "oosm",
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --host localhost",
    "build-stage": "ng build --configuration production --base-href /angular/stage/",
    "build-prod": "ng build --configuration production --base-href /angular/default/",
    "build": "node --max-old-space-size=2048 ./node_modules/@angular/cli/bin/ng build",
    "version:show": "node scripts/version/bump-version.cjs",
    "version:patch": "node scripts/version/bump-version.cjs patch",
    "version:minor": "node scripts/version/bump-version.cjs minor",
    "version:major": "node scripts/version/bump-version.cjs major",
    "serve:pwa": "npx http-server dist/ui -p 8080 -a 0.0.0.0 -c-1",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts --config=e2e/playwright.config.ts --project=chromium",
    "e2e:mobile": "playwright test e2e/mobile-experience.spec.ts --config=e2e/playwright.config.ts --project=mobile-chrome",
    "e2e:full": "playwright test --config=e2e/playwright.config.ts",
    "sync-user-guide-pdfs": "node ../docs/scripts/sync-pdfs-to-fe.mjs",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "prettier": "prettier --write ./src",
    "generate-pwa": "node generate-pwa-assets.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "19.0.5",
    "@angular/cdk": "^19.0.4",
    "@angular/common": "19.0.5",
    "@angular/compiler": "19.0.5",
    "@angular/core": "19.0.5",
    "@angular/forms": "19.0.5",
    "@angular/material": "~19.0.4",
    "@angular/material-moment-adapter": "19.0.4",
    "@angular/platform-browser": "19.0.5",
    "@angular/platform-browser-dynamic": "19.0.5",
    "@angular/router": "19.0.5",
    "@angular/service-worker": "19.0.5",
    "@iplab/ngx-file-upload": "19.0.3",
    "@newrelic/browser-agent": "^1.317.0",
    "@ngrx/signals": "^19.1.0",
    "@ngrx/store": "^19.1.0",
    "@ngx-translate/core": "^16.0.4",
    "@types/file-saver": "^2.0.7",
    "angular-calendar": "0.31.1",
    "angular-uploader": "8.41.1",
    "angularx-flatpickr": "8.1.0",
    "animate.css": "4.1.1",
    "apexcharts": "3.24.0",
    "arabic-reshaper": "^1.1.0",
    "bidi-js": "^1.0.3",
    "chart.js": "^4.5.1",
    "date-fns": "4.1.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "flatpickr": "4.6.13",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.10.3",
    "jsbarcode": "^3.12.3",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "jwt-decode": "^4.0.0",
    "lodash": "4.17.21",
    "mat-select-filter": "^2.4.1",
    "moment": "2.30.1",
    "ng-apexcharts": "1.8.0",
    "ng-recaptcha": "13.2.1",
    "ngx-cookie-service": "^19.1.2",
    "ngx-editor": "18.0.0",
    "ngx-mask": "19.0.6",
    "ngx-owl-carousel-o": "19.0.0",
    "ngx-print": "2.0.0",
    "ngx-quill": "27.0.0",
    "ngx-scrollbar": "16.1.1",
    "pdfmake": "^0.2.20",
    "quill": "2.0.3",
    "rxjs": "~7.8.1",
    "swagger-ui-dist": "^5.32.8",
    "uploader": "3.48.3",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.0.6",
    "@angular-eslint/builder": "19.0.2",
    "@angular-eslint/eslint-plugin": "19.0.2",
    "@angular-eslint/eslint-plugin-template": "19.0.2",
    "@angular-eslint/schematics": "19.0.2",
    "@angular-eslint/template-parser": "19.0.2",
    "@angular/cli": "19.0.6",
    "@angular/compiler-cli": "19.0.5",
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "4.17.13",
    "@types/pdfmake": "^0.2.11",
    "@types/quill": "2.0.14",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "eslint": "9.17.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "3.4.2",
    "pwa-asset-generator": "^8.0.5",
    "tslib": "2.8.1",
    "typescript": "5.6.3"
  }
}
